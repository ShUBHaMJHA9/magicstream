# ==============================================================================
# YT_LIVE Environment Variables
# Author: Shubham Kumar Jha
# License: MIT
# ==============================================================================

# Target Platform: youtube, facebook, twitch, kick, custom
STREAM_PLATFORM=youtube

# Your YouTube Stream Key (from YouTube Studio > Create Live Stream)
STREAM_KEY=your-youtube-stream-key-here

# Facebook Live Stream Key (if streaming to Facebook Live)
FB_STREAM_KEY=your-facebook-stream-key-here

# Custom RTMP / RTMPS Destination URL (if STREAM_PLATFORM=custom)
CUSTOM_RTMP_URL=rtmps://live-api-s.facebook.com:443/rtmp/your-key-here

# Streaming Mode (mode_1_radio, mode_2_yt_relay, mode_3_custom, mode_4_local_playlist, mode_5_direct_relay)
STREAM_MODE=mode_1_radio

# Media Paths
VIDEO_PATH=video/vid.mp4
AUDIO_SOURCE=audio/audio.txt
LOGO_PATH=logo/logo.svg

# Watermark Position (top-right, top-left, bottom-right, bottom-left, center)
LOGO_POSITION=top-right

# Video Quality Presets
RESOLUTION=1280x720
FPS=30
VIDEO_BITRATE=2500k
AUDIO_BITRATE=128k

# Hardware Acceleration: auto, nvenc, vaapi, cpu
HW_ACCEL=auto

# Web API / Dashboard Port
PORT=8000
